# Sandbox credentials: sandbox.airwallex.com > Account > Developer > API keys
# Paste the bare values: no quotes, no spaces, no "Client ID" label.
AWX_CLIENT_ID=
AWX_API_KEY=

# Only for kits 5-8, when acting for a connected account by default
# AWX_ON_BEHALF_OF=acct_...

# Claude (agent loop). Leave unset if you use `ant auth login`.
# ANTHROPIC_API_KEY=
# Needed only for user-level keys not tied to a workspace (Console > Settings > Workspaces)
# ANTHROPIC_WORKSPACE_ID=

# Kits 11-12: Metal testnet RPC endpoint (console-testnet.metalntwx.com). The id is a credential.
# METAL_RPC_URL=https://rpc-testnet.metalntwx.com/v1/<endpoint id>

# Group sales demo (scripts/group_sales.py, see GROUP_SALES.md)
# PAYMENTS=airwallex            # or simulated; default: airwallex when sandbox keys are set
# SELLER_MODE=claude            # or rules; default: claude when an Anthropic key is set
# BUYER_MODE=presenter          # or agent
# PUBLIC_BASE_URL=http://localhost:8010
# AWX_WEBHOOK_SECRET=           # only if Airwallex can reach /webhooks/airwallex (public URL)
# GS_ACCESS_TOKEN=              # optional: dashboard and API need <url>/?k=<token> once
# GS_HOTEL_ACCOUNT=acct_...     # the hotel's Airwallex connected account (Payments for Platforms); deposits are
#                               # collected for it and its share paid out by funds split. Optional: the dashboard's
#                               # "Hotel payout account" drawer can onboard one instead. This, when set, wins.
# GS_PORT=8010
# GS_VAR=var/groupsales         # state directory; DATABASE_URL switches to Postgres
# GS_SELLER_MODEL=claude-opus-5-5
# GS_BUYER_MODEL=claude-opus-5-5
